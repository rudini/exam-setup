{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Java: Compile",
      "type": "shell",
      "command": "mvn -q -B compile",
      "group": "build",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Java: Run",
      "type": "shell",
      "command": "mvn -q -B compile exec:java",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    }
  ]
}
